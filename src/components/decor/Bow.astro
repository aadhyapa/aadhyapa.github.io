---
/**
 * Bow: two loops, knot and tails.
 * Props:
 *   variant  'pink' | 'black' | 'green'   default 'pink'
 *   size     CSS width, default '4rem' (height follows)
 *   class    extra classes
 * Decorative: always aria-hidden.
 */
interface Props {
	variant?: 'pink' | 'black' | 'green';
	size?: string;
	class?: string;
}
const { variant = 'pink', size = '4rem', class: className = '' } = Astro.props;
---

<svg
	class:list={['bow', `bow--${variant}`, className]}
	style={`width:${size}`}
	viewBox="0 0 64 44"
	aria-hidden="true"
	focusable="false"
>
	<path class="bow-tail" d="M29 24 L17 41 L25 38 L29 42 L33 26 Z"></path>
	<path class="bow-tail" d="M35 24 L47 41 L39 38 L35 42 L31 26 Z"></path>
	<path class="bow-loop" d="M32 22 C21 3 4 1 3 14 C2 27 19 31 32 22 Z"></path>
	<path
		class="bow-loop"
		d="M32 22 C43 3 60 1 61 14 C62 27 45 31 32 22 Z"
	></path>
	<path class="bow-shade" d="M27 19 C20 11 12 9 9 13"></path>
	<path class="bow-shade" d="M37 19 C44 11 52 9 55 13"></path>
	<path class="bow-shine" d="M12 8 C16 7 20 9 22 11"></path>
	<path class="bow-shine" d="M42 11 C44 9 48 7 52 8"></path>
	<rect class="bow-knot" x="26" y="14" width="12" height="13" rx="4"></rect>
	<path class="bow-shine" d="M29 18 L29 22"></path>
</svg>

<style>
	.bow {
		--bow-fill: var(--color-pink);
		--bow-shade: var(--color-raspberry);
		--bow-shine: var(--color-white);
		--bow-line: var(--color-ink);
		height: auto;
		overflow: visible;
	}
	.bow--black {
		--bow-fill: var(--color-ink);
		--bow-shade: var(--color-deep-green);
		--bow-shine: var(--color-green);
	}
	.bow--green {
		--bow-fill: var(--color-green);
		--bow-shade: var(--color-deep-green);
	}
	.bow-loop,
	.bow-tail,
	.bow-knot {
		fill: var(--bow-fill);
		stroke: var(--bow-line);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}
	.bow-shade,
	.bow-shine {
		fill: none;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.bow-shade {
		stroke: var(--bow-shade);
	}
	.bow-shine {
		stroke: var(--bow-shine);
	}
</style>

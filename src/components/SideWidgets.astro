---
/**
 * SideWidgets: three small OS windows that float beside the page content:
 * a note, a loading bar and a thank-you. Hidden below 700px.
 * Window controls (x, OK, cancel) are decoration only, so they are aria-hidden
 * spans rather than dead buttons.
 */
import PixelHeart from './decor/PixelHeart.astro';
import ProgressBar from './ui/ProgressBar.astro';
---

<div class="widgets">
	<aside class="widget note" aria-label="Note">
		<div class="titlebar titlebar--pink">
			<span class="title">
				<PixelHeart size="1rem" />
				note.txt
			</span>
			<span class="x" aria-hidden="true">
				×
			</span>
		</div>
		<div class="menu-row" aria-hidden="true">
			<span>File</span>
			<span>Edit</span>
			<span>View</span>
		</div>
		<p class="scribble">Remember that a bad day is not a bad life.</p>
	</aside>

	<aside class="widget loading" aria-label="Now building">
		<div class="titlebar titlebar--green">
			<span class="title">loading.exe</span>
			<span class="x" aria-hidden="true">
				×
			</span>
		</div>
		<div class="body">
			<p class="pixel-text">now building an AI Interview Prep Tool...</p>
			<ProgressBar value={62} label="Building next project" tone="pink" />
			<div class="foot">
				<span class="pixel-text" aria-hidden="true">
					62%
				</span>
				<span class="fake-button" aria-hidden="true">
					cancel
				</span>
			</div>
		</div>
	</aside>

	<aside class="widget thanks" aria-label="Thank you">
		<div class="titlebar titlebar--pink">
			<span class="title" aria-hidden="true">
				<PixelHeart size="1rem" />
				<PixelHeart size="1rem" />
			</span>
		</div>
		<div class="body body--center">
			<p class="thanks-text">thank you for visiting</p>
			<span class="fake-button" aria-hidden="true">
				ok
			</span>
		</div>
		<PixelHeart class="dangle" variant="pink" size="2rem" />
	</aside>
</div>

<style>
	.widgets {
		position: fixed;
		inset: 0;
		z-index: 1;
		pointer-events: none;
	}

	.widget {
		position: absolute;
		display: flex;
		flex-direction: column;
		background: var(--color-blush);
		border: var(--outline-width) solid var(--color-ink);
		border-radius: var(--radius-window-sm);
		box-shadow: var(--shadow-md);
	}

	.note {
		left: 1.5%;
		top: 19%;
		width: 12.5rem;
		rotate: -3deg;
	}
	.loading {
		right: 1.5%;
		top: 24%;
		width: 12.5rem;
		rotate: 1.5deg;
	}
	.thanks {
		right: 2%;
		top: 55%;
		width: 10.5rem;
		rotate: -2deg;
	}

	.titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-2);
		min-height: 1.75rem;
		font-family: var(--font-pixel);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-ink);
		border-bottom: var(--outline-width) solid var(--color-ink);
		border-radius: calc(var(--radius-window-sm) - var(--outline-width))
			calc(var(--radius-window-sm) - var(--outline-width)) 0 0;
	}
	.titlebar--pink {
		background: var(--color-pink);
	}
	.titlebar--green {
		background: var(--color-green);
	}
	.title {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
	}
	.x {
		display: inline-grid;
		place-items: center;
		width: 1.125rem;
		height: 1.125rem;
		line-height: 1;
		background: var(--color-white);
		border: 2px solid var(--color-ink);
	}

	.menu-row {
		display: flex;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-2);
		font-size: var(--text-sm);
		color: var(--color-text);
		border-bottom: 1px solid var(--color-lace);
	}
	.scribble {
		padding: var(--space-3);
		font-family: var(--font-hand);
		font-size: var(--text-lg);
		line-height: 1.3;
		text-align: center;
		color: var(--color-raspberry);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-3);
	}
	.body--center {
		align-items: center;
		text-align: center;
	}
	.pixel-text {
		font-family: var(--font-pixel);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-deep-green);
	}
	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.thanks-text {
		font-family: var(--font-pixel);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		letter-spacing: 0.12em;
		line-height: 1.5;
		text-transform: uppercase;
		color: var(--color-raspberry);
	}
	.fake-button {
		padding: 0 var(--space-3);
		font-family: var(--font-pixel);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: 0.1em;
		line-height: 1.6;
		text-transform: uppercase;
		color: var(--color-ink);
		background: var(--color-mint);
		border: 2px solid var(--color-ink);
		box-shadow: var(--shadow-sm);
	}
	.dangle {
		position: absolute;
		right: 1rem;
		bottom: -1.75rem;
	}

	@media (max-width: 43.75rem) {
		.widgets {
			display: none;
		}
	}

	/* Quiet theme: the widgets are decoration only, so they are not rendered. */
	:global(:root[data-theme='quiet']) .widgets {
		display: none;
	}
</style>

---
/**
 * ProgressBar: segmented bar in a dark outlined slot.
 * Props:
 *   value     0 to 100
 *   label     accessible name, required (e.g. "Building next project")
 *   segments  number of blocks, default 12
 *   tone      'pink' | 'green'   default 'pink'
 *   class     extra classes
 * Renders role="progressbar"; the blocks are aria-hidden.
 */
interface Props {
	value: number;
	label: string;
	segments?: number;
	tone?: 'pink' | 'green';
	class?: string;
}
const {
	value,
	label,
	segments = 12,
	tone = 'pink',
	class: className = '',
} = Astro.props;
const clamped = Math.min(100, Math.max(0, value));
const filled = Math.round((clamped / 100) * segments);
---

<div
	class:list={['progress-bar', `progress-bar--${tone}`, className]}
	role="progressbar"
	aria-label={label}
	aria-valuemin="0"
	aria-valuemax="100"
	aria-valuenow={clamped}
>
	{Array.from({ length: segments }, (_, i) => (
		<span
			class:list={['segment', i < filled && 'segment--on']}
			aria-hidden="true"
		/>
	))}
</div>

<style>
	.progress-bar {
		--bar-fill: var(--color-pink);
		display: flex;
		gap: 3px;
		padding: 3px;
		height: 1.5rem;
		background: var(--color-white);
		border: 2px solid var(--color-ink);
		border-radius: var(--radius-sm);
	}
	.progress-bar--green {
		--bar-fill: var(--color-green);
	}
	.segment {
		flex: 1;
		background: var(--color-blush);
		border-radius: 2px;
	}
	.segment--on {
		background: var(--bar-fill);
		box-shadow: inset 0 0 0 1px var(--color-ink);
	}

	/* Quiet theme: hairline slot and flat segments, no inset shadow. */
	:global(:root[data-theme='quiet']) .progress-bar {
		--bar-fill: var(--color-muted);
		background: transparent;
		border-color: transparent;
		outline: 1px solid var(--color-line);
		outline-offset: -1.5px;
	}
	:global(:root[data-theme='quiet']) .progress-bar--green {
		--bar-fill: var(--color-muted);
	}
	:global(:root[data-theme='quiet']) .segment {
		background: var(--color-line);
	}
	:global(:root[data-theme='quiet']) .segment--on {
		background: var(--bar-fill);
		box-shadow: none;
	}
</style>

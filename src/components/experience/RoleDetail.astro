---
/**
 * RoleDetail: body of the work-entry window, a white sheet on gingham.
 * Props:
 *   entry   a work entry from the experience collection
 * If the entry names a related letter (a `letter` frontmatter id that exists in
 * the letters collection) a closing button links to it; otherwise it is left out.
 */
import { getEntry } from 'astro:content';
import PearlBullet from '../ui/PearlBullet.astro';
import Pill from '../ui/Pill.astro';
import RibbonLabel from '../ui/RibbonLabel.astro';
import StickerButton from '../ui/StickerButton.astro';
import { formatSpan, type Entry } from './entries';

interface Props {
	entry: Entry;
}

const { entry } = Astro.props;
if (entry.data.kind !== 'work') {
	throw new Error(`RoleDetail only renders work entries, got "${entry.id}"`);
}
const { title, organization, summary, did, stack, learned } = entry.data;

// The schema does not declare a letter link yet; read it defensively.
const letterId = (entry.data as { letter?: string }).letter;
const letter = letterId ? await getEntry('letters', letterId) : undefined;
const pillTones = ['pink', 'green', 'white'] as const;
---

<div class="role-gingham gingham gingham--mint">
	<article class="sheet">
		<p class="meta">
			<Pill tone="green" pixel>
				work
			</Pill>
			<span class="dates">{formatSpan(entry.data)}</span>
		</p>
		<h1 class="title">{title}</h1>
		<p class="org">{organization}</p>
		<p class="summary">{summary}</p>

		<section class="block" aria-label="what i did">
			<RibbonLabel as="h2">what i did</RibbonLabel>
			<ul class="did">
				{did.map((item) => (
					<li>
						<PearlBullet />
						<span>{item}</span>
					</li>
				))}
			</ul>
			<div class="stack">
				<span class="stack-label" id="stack-label">
					stack
				</span>
				<ul class="pills" aria-labelledby="stack-label">
					{stack.map((tool, i) => (
						<li>
							<Pill tone={pillTones[i % pillTones.length]}>{tool}</Pill>
						</li>
					))}
				</ul>
			</div>
		</section>

		<hr class="divider" />

		<section class="block" aria-label="what i learned">
			<RibbonLabel as="h2">what i learned</RibbonLabel>
			<ol class="lessons">
				{learned.map((lesson, i) => (
					<li>
						<span
							class:list={['badge', i % 2 === 1 && 'badge--green']}
							aria-hidden="true"
						>
							{String(i + 1).padStart(2, '0')}
						</span>
						<div>
							<h3 class="lesson-title">{lesson.title}</h3>
							<p class="lesson-text">{lesson.text}</p>
						</div>
					</li>
				))}
			</ol>
		</section>

		{letter && (
			<footer class="closing">
				<p class="hand">there is a longer story behind this one</p>
				<StickerButton href={`/letters/${letter.id}`}>
					read the letter about it <span aria-hidden="true">→</span>
				</StickerButton>
			</footer>
		)}
	</article>
</div>

<style>
	.role-gingham {
		--gingham-size: 28px;
		--bleed: var(--space-5);
		margin: calc(var(--bleed) * -1);
		padding: var(--space-5) var(--space-6);
	}
	.sheet {
		padding: var(--space-5) var(--space-6) var(--space-6);
		background: var(--color-white);
		border: var(--outline-width) solid var(--color-ink);
		border-radius: var(--radius-window);
		color: var(--color-text);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin: 0 0 var(--space-2);
	}
	.dates {
		font-size: var(--text-sm);
	}
	.title {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: 400;
		line-height: var(--leading-tight);
		color: var(--color-ink);
		text-shadow: 2px 2px 0 var(--color-pink);
		overflow-wrap: anywhere;
	}
	.org {
		margin: var(--space-1) 0 0;
		font-size: var(--text-md);
	}
	.summary {
		margin: var(--space-4) 0 0;
		font-size: var(--text-md);
		line-height: var(--leading-body);
	}

	.block {
		margin-block-start: var(--space-5);
	}
	.block > :global(h2) {
		margin: 0 0 var(--space-3);
	}

	.did,
	.pills,
	.lessons {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.did li {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
		padding-block: var(--space-1);
		line-height: var(--leading-body);
	}
	.did :global(.pearl-bullet) {
		translate: 0 0.1em;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
		margin-block-start: var(--space-3);
	}
	.stack-label {
		font-weight: var(--weight-bold);
	}
	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.divider {
		margin: var(--space-5) 0 0;
		border: 0;
		border-block-start: 2px dashed var(--color-pink);
	}

	.lessons {
		display: grid;
		gap: var(--space-4);
	}
	.lessons li {
		display: flex;
		align-items: flex-start;
		gap: var(--space-4);
	}
	.badge {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 3rem;
		block-size: 3rem;
		font-family: var(--font-pixel);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		color: var(--color-ink);
		background: var(--color-pink-light);
		border: var(--outline-width) solid var(--color-ink);
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-sm);
	}
	.badge--green {
		background: var(--color-mint);
	}
	.lesson-title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		line-height: 1.3;
		color: var(--color-ink);
	}
	.lesson-text {
		margin: var(--space-1) 0 0;
		line-height: var(--leading-body);
	}

	.closing {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-5);
		margin-block-start: var(--space-6);
	}
	.hand {
		margin: 0;
		font-family: var(--font-hand);
		font-size: var(--text-xl);
		color: var(--color-raspberry);
	}

	@media (max-width: 43.75rem) {
		.role-gingham {
			--bleed: var(--space-4);
			padding: var(--space-4);
		}
		.sheet {
			padding: var(--space-4);
		}
		.title {
			font-size: var(--text-xl);
		}
	}
</style>

---
/**
 * HomeCard: the home page card. Lace frame around a gingham card with a ribbon label,
 * heart-shaped portrait, intro, pills, bio, status tiles, link directory and icon strip.
 * Every [bracket] is a placeholder to replace with real content.
 * Decorative parts are aria-hidden; the only heading above the directory is the h1.
 */
import Bow from './decor/Bow.astro';
import LaceEdge from './decor/LaceEdge.astro';
import Leaf from './decor/Leaf.astro';
import PixelHeart from './decor/PixelHeart.astro';
import Pill from './ui/Pill.astro';
import RibbonLabel from './ui/RibbonLabel.astro';
import StatusTile from './ui/StatusTile.astro';
import StickerButton from './ui/StickerButton.astro';

const status = [
	{ label: 'watching', value: 'Steven Universe ', tone: 'green' },
	{ label: 'learning', value: 'Rock Climbing', tone: 'pink' },
	{ label: 'reading', value: 'Immortal Rose', tone: 'green' },
	{ label: 'listening', value: 'Sunday Candy', tone: 'pink' },
] as const;

const contact = [
	{
		href: 'mailto:aadhya.pandilla@gmail.com',
		label: 'Email',
		variant: 'pink',
		icon: 'mail',
	},
	{
		href: 'https://github.com/aadhyapa',
		label: 'GitHub',
		variant: 'green',
		icon: 'github',
	},
	{
		href: 'https://www.linkedin.com/in/aadhyapa',
		label: 'LinkedIn',
		variant: 'white',
		icon: 'linkedin',
	},
] as const;

const links = [
	{ href: '/experience', label: 'Experience', variant: 'pink', icon: 'folder' },
	{ href: '/letters', label: 'Letters', variant: 'green', icon: 'mail' },
	{
		href: '/Aadhya_Pandillapally_Resume.pdf',
		label: 'Résumé ↓',
		variant: 'white',
		icon: 'doc',
		download: true,
	},
] as const;
---

<main class="home">
	<div class="lace-frame">
		<LaceEdge position="top" size="22px" />
		<section class="card gingham">
			<p class="ribbon-wrap">
				<RibbonLabel as="span">
					welcome to my corner of the internet
				</RibbonLabel>
			</p>

			<div class="intro">
				<div class="portrait">
					<span class="bow bow-black">
						<Bow variant="black" size="3.75rem" />
					</span>
					<span class="bow bow-pink">
						<Bow variant="pink" size="2.25rem" />
					</span>
					<svg
						class="heart-defs"
						width="0"
						height="0"
						aria-hidden="true"
						focusable="false"
					>
						<clipPath id="heart-clip" clipPathUnits="objectBoundingBox">
							<path d="M0.5 0.95 C0.1 0.62 0.02 0.42 0.02 0.28 C0.02 0.12 0.14 0.03 0.27 0.03 C0.38 0.03 0.46 0.09 0.5 0.18 C0.54 0.09 0.62 0.03 0.73 0.03 C0.86 0.03 0.98 0.12 0.98 0.28 C0.98 0.42 0.9 0.62 0.5 0.95 Z"></path>
						</clipPath>
					</svg>
					<div class="heart-outer" aria-hidden="true">
						<div class="heart-inner">
							<img
								class="photo"
								src="/portfolio-cute-picture.jpg"
								alt="Aadhya smiling at a paint bar table, chin resting on her hands"
								width="1200"
								height="1600"
							/>
							<span class="placeholder">[your photo]</span>
						</div>
					</div>
					<canvas
						class="ascii"
						data-ascii-portrait
						data-src="/portfolio-website-picture.svg"
						aria-hidden="true"
					></canvas>
					<img
						class="ascii-fallback"
						src="/portfolio-website-picture.svg"
						alt=""
						aria-hidden="true"
						loading="lazy"
					/>
				</div>

				<div class="intro-text">
					<h1>
						<span class="hi">hi, i'm</span>
						<span class="name">Aadhya Pandillapally</span>
					</h1>
					<p class="prev">Prev @ Hudl</p>
					<ul class="pills">
						<li>
							<Pill tone="pink">Software Engineer</Pill>
						</li>
						<li>
							<Pill tone="green">East Lansing</Pill>
						</li>
						<li>
							<Pill>she/her</Pill>
						</li>
					</ul>
					<p class="bio">
						Software and ML Engineer. I build Tech that improves people lives.
						When I am not coding, I am learning something new like rock climbing, 
						baking, or archeology.
					</p>
				</div>
			</div>

			<section class="block" aria-label="Status">
				<RibbonLabel as="h2" class="block-label">
					status
				</RibbonLabel>
				<ul class="status">
					{status.map((s) => (
						<li>
							<StatusTile label={s.label} value={s.value} tone={s.tone} />
						</li>
					))}
				</ul>
			</section>

			<section class="block" aria-label="Contact">
				<ul class="directory">
					{contact.map((c) => (
						<li>
							<StickerButton
								class="contact-link"
								href={c.href}
								variant={c.variant}
								aria-label={c.label}
								target={c.href.startsWith('http') ? '_blank' : undefined}
								rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
							>
								<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
									{c.icon === 'mail' && (
										<>
											<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
											<polyline points="22,6 12,13 2,6" />
										</>
									)}
									{c.icon === 'github' && (
										<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
									)}
									{c.icon === 'linkedin' && (
										<>
											<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
											<rect x="2" y="9" width="4" height="12" />
											<circle cx="4" cy="4" r="2" />
										</>
									)}
								</svg>
							</StickerButton>
						</li>
					))}
				</ul>
			</section>

			<div class="strip" aria-hidden="true">
				<PixelHeart variant="pink" size="1.5rem" />
				<Leaf size="1.5rem" />
				<Bow variant="pink" size="2.25rem" />
				<PixelHeart variant="green" size="1.5rem" />
				<Bow variant="black" size="2.25rem" />
				<Leaf size="1.5rem" />
				<PixelHeart variant="pink" size="1.5rem" />
			</div>
		</section>
		<LaceEdge position="bottom" size="22px" />
	</div>
</main>

<style>
	.home {
		position: relative;
		z-index: 1;
		padding: calc(var(--space-8) + var(--space-5)) var(--space-4) var(--space-8);
	}

	.lace-frame {
		max-width: 54rem;
		margin-inline: auto;
		padding: var(--space-3);
		background: var(--color-lace);
		border: var(--outline-width) solid var(--color-ink);
		border-radius: var(--radius-window);
		box-shadow: var(--shadow-lg);
	}

	.card {
		/* Slightly paler checks keep the raspberry "hi, i'm" at 4.5:1 on the darkest squares. */
		--gingham-strength: 34%;
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		padding: var(--space-6) var(--space-6) var(--space-5);
		border: var(--outline-width) solid var(--color-ink);
		border-radius: var(--radius-window-sm);
	}

	.ribbon-wrap {
		text-align: center;
		margin-block-start: calc(var(--space-2) * -1);
	}

	.intro {
		display: grid;
		grid-template-columns: 15rem 1fr;
		gap: var(--space-6);
		align-items: center;
	}

	.portrait {
		position: relative;
		width: 15rem;
		aspect-ratio: 1;
	}
	.heart-defs {
		position: absolute;
	}
	.heart-outer {
		width: 100%;
		height: 100%;
		background: var(--color-ink);
		clip-path: url(#heart-clip);
	}
	.heart-inner {
		position: absolute;
		inset: 0.55rem;
		display: grid;
		place-items: center;
		font-family: var(--font-pixel);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-ink);
		background: var(--color-mint);
		clip-path: url(#heart-clip);
	}
	/* Cute theme shows the photo; quiet swaps it for the placeholder / ASCII portrait. */
	.photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 55% 30%;
	}
	.placeholder {
		display: none;
	}
	:global(:root[data-theme='quiet']) .photo {
		display: none;
	}
	:global(:root[data-theme='quiet']) .placeholder {
		display: inline;
	}
	.bow {
		position: absolute;
		z-index: 1;
	}
	.bow-black {
		top: -0.4rem;
		left: -0.9rem;
		rotate: -12deg;
	}
	.bow-pink {
		right: 0.2rem;
		bottom: 1.1rem;
		rotate: 14deg;
	}

	h1 {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}
	.hi {
		font-family: var(--font-hand);
		font-size: var(--text-xl);
		color: var(--color-raspberry);
	}
	.name {
		font-size: var(--text-2xl);
		line-height: var(--leading-tight);
		text-shadow: 3px 3px 0 var(--color-pink);
	}

	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		margin: var(--space-3) 0;
		list-style: none;
	}

	.bio {
		max-width: 34rem;
	}

	.block {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.block :global(.block-label) {
		align-self: flex-start;
	}
	.block[aria-label='Contact'] {
		align-items: center;
	}
	.block[aria-label='Contact'] :global(.block-label) {
		align-self: center;
	}

	.status,
	.directory {
		display: grid;
		gap: var(--space-3);
		padding: 0;
		list-style: none;
	}
	.status {
		grid-template-columns: repeat(4, 1fr);
	}
	.status :global(.status-tile) {
		height: 100%;
	}
	.directory {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
	}
	.prev {
		margin-block: var(--space-1) var(--space-2);
		font-weight: var(--weight-bold);
		color: var(--color-ink);
	}
	:global(:root[data-theme='quiet']) .prev {
		font-weight: var(--weight-medium);
		color: var(--color-muted);
	}

	.icon {
		width: 1.4rem;
		height: 1.4rem;
		fill: none;
		stroke: var(--color-ink);
		stroke-width: 1.8;
		stroke-linejoin: round;
		stroke-linecap: round;
	}

	.strip {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-block: 2px dashed var(--color-lace);
	}

	@media (max-width: 56rem) {
		.status {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 43.75rem) {
		.card {
			padding: var(--space-5) var(--space-4);
		}
		.intro {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}
		.pills {
			justify-content: center;
		}
		.status {
			grid-template-columns: 1fr;
		}
	}

	/* Quiet theme: one hairline panel, left-aligned mono type, no frame or ribbons.
	   Hairlines are outlines drawn inside transparent borders, so every box keeps
	   the size it has in the cute theme. */
	:global(:root[data-theme='quiet']) .lace-frame {
		background: transparent;
		border-color: transparent;
		box-shadow: none;
	}
	:global(:root[data-theme='quiet']) .card {
		border-color: transparent;
		outline: 1px solid var(--color-line);
		outline-offset: calc(var(--outline-width) / -2 - 0.5px);
	}
	:global(:root[data-theme='quiet']) .ribbon-wrap,
	:global(:root[data-theme='quiet']) .intro {
		text-align: left;
	}
	:global(:root[data-theme='quiet']) .card :global(.ribbon-label) {
		color: var(--color-muted);
		padding-inline: 0;
		background: none;
		clip-path: none;
	}
	:global(:root[data-theme='quiet']) .status :global(.status-icon) {
		display: none;
	}
	/* Quiet only: the photo as interactive ASCII. Hidden in the cute theme and until the
	   image has loaded, so the placeholder stays if it fails. Vertical swipes still scroll. */
	.ascii {
		display: none;
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		touch-action: pan-y;
		cursor: crosshair;
	}
	:global(:root[data-theme='quiet']) .ascii[data-ready] {
		display: block;
	}
	/* If the canvas fails, show the same SVG as a plain black and white image. */
	.ascii-fallback {
		display: none;
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: contain;
		filter: grayscale(1);
	}
	:global(:root[data-theme='quiet']) .portrait:has(.ascii[data-failed]) .ascii-fallback {
		display: block;
	}
	:global(:root[data-theme='quiet']) .portrait:has(.ascii[data-failed]) .heart-outer {
		display: none;
	}
	:global(:root[data-theme='quiet'])
		.portrait:has(.ascii:is([data-ready], [data-failed]))
		.heart-inner
		.placeholder {
		visibility: hidden;
	}
	/* Once the ASCII portrait is ready it stands alone: no box, bigger, and the
	   image's own aspect. Until then the placeholder box stays. */
	:global(:root[data-theme='quiet']) .portrait:has(.ascii:is([data-ready], [data-failed])) {
		width: 13rem;
		aspect-ratio: 369 / 676;
	}
	@media (min-width: 43.76rem) {
		:global(:root[data-theme='quiet']) .intro:has(.ascii:is([data-ready], [data-failed])) {
			grid-template-columns: 13rem 1fr;
			gap: var(--space-8);
			align-items: stretch;
		}
		/* Side by side: the portrait is as tall as the text beside it. */
		:global(:root[data-theme='quiet']) .portrait:has(.ascii:is([data-ready], [data-failed])) {
			width: 100%;
			aspect-ratio: auto;
		}
	}
	:global(:root[data-theme='quiet'])
		.portrait:has(.ascii:is([data-ready], [data-failed]))
		.heart-outer {
		display: none;
	}
	/* The placeholder keeps its box but loses the heart cut-out. */
	:global(:root[data-theme='quiet']) .heart-outer {
		background: var(--color-line);
		clip-path: none;
		border-radius: var(--radius-window);
	}
	:global(:root[data-theme='quiet']) .heart-inner {
		color: var(--color-muted);
		background: var(--color-surface);
		clip-path: none;
		border-radius: var(--radius-sm);
	}
	:global(:root[data-theme='quiet']) .hi {
		font-family: var(--font-body);
		color: var(--color-muted);
	}
	:global(:root[data-theme='quiet']) .name {
		color: var(--color-ink);
		font-weight: var(--weight-medium);
		text-shadow: none;
	}
	:global(:root[data-theme='quiet']) .pills :global(.pill),
	:global(:root[data-theme='quiet']) .status :global(.status-tile) {
		color: var(--color-text);
		background: transparent;
		border-color: transparent;
		outline: 1px solid var(--color-line);
		outline-offset: -1.5px;
	}
	:global(:root[data-theme='quiet']) .status :global(strong) {
		color: var(--color-muted);
		font-weight: var(--weight-medium);
	}
	:global(:root[data-theme='quiet']) .directory :global(.sticker-button) {
		color: var(--color-ink);
		background: transparent;
		border-width: var(--hairline-width);
		border-color: var(--color-line);
		box-shadow: none;
		transform: none;
	}
	:global(:root[data-theme='quiet']) .directory :global(.sticker-button:hover) {
		border-color: var(--color-ink);
	}
	:global(:root[data-theme='quiet']) .strip {
		border-block-color: transparent;
		background: linear-gradient(var(--color-line), var(--color-line)) top / 100%
			1px no-repeat;
		background-origin: border-box;
	}
</style>

<script>
	import '../scripts/ascii-portrait.ts';
</script>

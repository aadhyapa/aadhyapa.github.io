---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<div id="backdrop" transition:persist>
			<h1>Backdrop</h1>
			<p>
				Loaded at <time id="backdrop-loaded">…</time>
			</p>
			<nav aria-label="Test routes">
				<a href="/">Home</a>
				<a href="/about">About</a>
			</nav>
		</div>
		<slot />
		<script is:inline>
			const stamp = document.getElementById('backdrop-loaded');
			if (stamp && !stamp.dataset.set) {
				stamp.dataset.set = 'true';
				stamp.textContent = new Date().toISOString();
			}
		</script>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	#backdrop {
		min-height: 100vh;
		padding: 1rem;
		background: var(--color-mint);
	}

	dialog[open] {
		position: fixed;
		inset: 20% auto auto 50%;
		translate: -50% 0;
		border: var(--outline-width) solid var(--color-ink);
		background: var(--color-white);
	}
</style>

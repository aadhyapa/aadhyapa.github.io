---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/gingham.css';
import '../styles/scallop.css';
import '../styles/responsive.css';
import Backdrop from '../components/Backdrop.astro';
import MenuBar from '../components/MenuBar.astro';
import SideWidgets from '../components/SideWidgets.astro';
import quicksand from '@fontsource-variable/quicksand/files/quicksand-latin-wght-normal.woff2?url';
import silkscreen from '@fontsource/silkscreen/files/silkscreen-latin-700-normal.woff2?url';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{
			[quicksand, silkscreen].map((href) => (
				<link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
			))
		}
		<ClientRouter />
	</head>
	<body>
		<div id="backdrop" transition:persist>
			<Backdrop />
			<SideWidgets />
		</div>
		<div id="menubar" transition:persist>
			<MenuBar />
		</div>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		min-height: 100%;
	}
</style>

<script>
	import '../scripts/window.ts';
</script>

---
import Layout from '../../layouts/Layout.astro';
import Window from '../../components/Window.astro';
import LetterBody from '../../components/letters/LetterBody.astro';
import { loadPublished } from '../../components/letters/letters';

export async function getStaticPaths() {
	const letters = await loadPublished();
	return letters.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<Layout title={entry.data.title}>
	<Window
		title={`letters / ${entry.data.title}`}
		backHref="/letters"
		closeHref="/"
	>
		<LetterBody entry={entry} />
	</Window>
</Layout>

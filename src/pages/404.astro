---
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import PixelHeart from '../components/decor/PixelHeart.astro';
import StickerButton from '../components/ui/StickerButton.astro';
---

<Layout title="Page missing">
	<Window title="error.exe" closeHref="/">
		<div class="missing">
			<PixelHeart variant="raspberry" size="6rem" class="missing-heart" />
			<h1>this page is missing</h1>
			<p>
				I looked everywhere, even under the cushions, but nothing lives at this
				address. Let's get you back somewhere cozy.
			</p>
			<StickerButton href="/">take me home</StickerButton>
		</div>
	</Window>
</Layout>

<style>
	.missing {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
		padding-block: var(--space-6);
		text-align: center;
	}
	.missing h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: normal;
		color: var(--color-ink);
	}
	.missing p {
		max-inline-size: 32rem;
		margin: 0;
	}
</style>
